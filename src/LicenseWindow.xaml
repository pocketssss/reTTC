<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TTC — ключ" Width="500" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        FontFamily="Bahnschrift" FontSize="14" Foreground="#ECE7DC" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
  <!-- Те же токены, что в MainWindow.xaml: асфальт #15171B, планшет #1D2026, линии #2B2F37, мел #ECE7DC, туман #8E929B, сигнал #8B5CF6 -->
  <Window.Resources>
    <SolidColorBrush x:Key="Asphalt" Color="#15171B"/>
    <SolidColorBrush x:Key="Slate" Color="#1D2026"/>
    <SolidColorBrush x:Key="Rule" Color="#2B2F37"/>
    <SolidColorBrush x:Key="Chalk" Color="#ECE7DC"/>
    <SolidColorBrush x:Key="Fog" Color="#8E929B"/>
    <SolidColorBrush x:Key="Signal" Color="#8B5CF6"/>

    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Chalk}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="{StaticResource Rule}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Height" Value="44"/>
      <Setter Property="Padding" Value="16,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <Border x:Name="hover" Background="#FFFFFF" Opacity="0" CornerRadius="8" IsHitTestVisible="False"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="hover" Property="Opacity" Value="0.06"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="hover" Property="Opacity" Value="0.12"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.35"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="{StaticResource Signal}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Signal}"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Plain" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Foreground" Value="{StaticResource Fog}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.75"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="WinClose" TargetType="Button">
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Foreground" Value="{StaticResource Fog}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#C9384F"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Field" TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource Slate}"/>
      <Setter Property="Foreground" Value="{StaticResource Chalk}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Rule}"/>
      <Setter Property="CaretBrush" Value="#8B5CF6"/>
      <Setter Property="SelectionBrush" Value="#8B5CF6"/>
      <Setter Property="FontStretch" Value="Condensed"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="21"/>
      <Setter Property="Padding" Value="12,2"/>
      <Setter Property="Height" Value="50"/>
      <Setter Property="CharacterCasing" Value="Upper"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="#8B5CF6"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border Margin="14" CornerRadius="12" Background="{StaticResource Asphalt}" BorderBrush="{StaticResource Rule}" BorderThickness="1">
    <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.6" Color="#000000"/></Border.Effect>
    <StackPanel>
      <Grid x:Name="TitleBar" Background="#01000000" Height="56">
        <StackPanel Orientation="Horizontal" Margin="22,0,0,0" VerticalAlignment="Center">
          <Image x:Name="LogoImg" Width="28" Height="28"/>
          <TextBlock Text="TTC" FontSize="18" FontWeight="SemiBold" Margin="11,0,0,1" VerticalAlignment="Center"/>
          <TextBlock x:Name="SubTitle" Text="ключ доступа" Foreground="{StaticResource Fog}" FontSize="13" Margin="12,2,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <Button x:Name="BtnClose" Style="{StaticResource WinClose}" Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <Rectangle Height="1" Fill="{StaticResource Rule}" VerticalAlignment="Bottom"/>
      </Grid>

      <StackPanel Margin="24,22,24,24">
        <!-- проверка -->
        <StackPanel x:Name="BusyPanel" Visibility="Collapsed" Margin="0,8,0,8">
          <TextBlock x:Name="BusyText" Text="Проверяю ключ" FontSize="15" HorizontalAlignment="Center"/>
          <Border Height="3" CornerRadius="1.5" Background="{StaticResource Rule}" Margin="60,16,60,0" ClipToBounds="True">
            <Border x:Name="BusyBar" Width="80" HorizontalAlignment="Left" CornerRadius="1.5" Background="{StaticResource Signal}">
              <Border.RenderTransform><TranslateTransform X="0"/></Border.RenderTransform>
            </Border>
          </Border>
        </StackPanel>

        <!-- ввод -->
        <StackPanel x:Name="InputPanel">
          <TextBlock Text="Ключ из личного кабинета" Foreground="{StaticResource Fog}" FontSize="13" Margin="0,0,0,8"/>
          <TextBox x:Name="KeyBox" Style="{StaticResource Field}" MaxLength="40"/>
          <StackPanel x:Name="ErrRow" Orientation="Horizontal" Margin="0,12,0,0" Visibility="Collapsed">
            <Rectangle Width="8" Height="8" RadiusX="1.5" RadiusY="1.5" Fill="#F0506E" VerticalAlignment="Top" Margin="0,5,0,0"/>
            <TextBlock x:Name="ErrText" Foreground="#F0506E" FontSize="13" TextWrapping="Wrap" Margin="8,0,0,0" MaxWidth="404" LineHeight="18"/>
          </StackPanel>
          <TextBlock x:Name="HintText" Foreground="{StaticResource Fog}" FontSize="12.5" TextWrapping="Wrap" LineHeight="17" Margin="0,12,0,0"
                     Text="Вида CAPT-XXXX-XXXX-XXXX-XXXX. Ключ привяжется к этому компьютеру, срок пойдёт с первой активации."/>
          <Grid Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="10"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BtnActivate" Style="{StaticResource Primary}" Content="Активировать" IsDefault="True"/>
            <Button x:Name="BtnPaste" Grid.Column="2" Style="{StaticResource Btn}" Content="Вставить" ToolTip="Вставить ключ из буфера обмена"/>
          </Grid>
          <Grid Margin="0,16,0,0">
            <Button x:Name="BtnSite" Style="{StaticResource Plain}" HorizontalAlignment="Left">
              <TextBlock Text="Купить ключ в личном кабинете" Foreground="#A78BFA" FontSize="13"/>
            </Button>
            <TextBlock x:Name="HwidText" Foreground="#5A5E66" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
          </Grid>
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
