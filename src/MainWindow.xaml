<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TTC" Width="1100" Height="872" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        FontFamily="Bahnschrift" FontSize="14" Foreground="#ECE7DC" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
  <!--
    Токены: графит асфальта #15171B, планшет #1D2026, линии сетки #2B2F37,
    мел #ECE7DC (основной текст), туман #8E929B (вторичный), сигнал #8B5CF6 (цвет логотипа).
    Статусы: готово #46D39A, внимание #F2B33D, стоп #F0506E.
    Шрифт: Bahnschrift (DIN-подобный, как дорожные знаки и HUD), цифры узким начертанием.
  -->
  <Window.Resources>
    <SolidColorBrush x:Key="Asphalt" Color="#15171B"/>
    <SolidColorBrush x:Key="Slate" Color="#1D2026"/>
    <SolidColorBrush x:Key="Rule" Color="#2B2F37"/>
    <SolidColorBrush x:Key="Chalk" Color="#ECE7DC"/>
    <SolidColorBrush x:Key="Fog" Color="#8E929B"/>
    <SolidColorBrush x:Key="Signal" Color="#8B5CF6"/>

    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Fog}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Fog}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="LineHeight" Value="17"/>
    </Style>
    <Style x:Key="Num" TargetType="TextBlock">
      <Setter Property="FontStretch" Value="Condensed"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
      <Setter Property="Foreground" Value="{StaticResource Chalk}"/>
    </Style>

    <!-- Кнопки: прямоугольники с малым скруглением, реагируют только на наведение и нажатие -->
    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Chalk}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="{StaticResource Rule}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <Border x:Name="hover" Background="#FFFFFF" Opacity="0" CornerRadius="8" IsHitTestVisible="False"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="hover" Property="Opacity" Value="0.06"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="hover" Property="Opacity" Value="0.12"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.35"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="{StaticResource Signal}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Signal}"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="StopBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="BorderBrush" Value="#4A2630"/>
      <Setter Property="Foreground" Value="#F0506E"/>
    </Style>
    <Style x:Key="Small" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Background" Value="{StaticResource Slate}"/>
      <Setter Property="Foreground" Value="{StaticResource Fog}"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style x:Key="Quick" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Padding" Value="9,4"/>
      <Setter Property="Margin" Value="0,0,6,6"/>
      <Setter Property="Foreground" Value="{StaticResource Fog}"/>
    </Style>
    <Style x:Key="Plain" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Foreground" Value="{StaticResource Fog}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.75"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="WinBtn" TargetType="Button">
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Foreground" Value="{StaticResource Fog}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#262A31"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="WinClose" TargetType="Button" BasedOn="{StaticResource WinBtn}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#C9384F"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Field" TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource Slate}"/>
      <Setter Property="Foreground" Value="{StaticResource Chalk}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Rule}"/>
      <Setter Property="CaretBrush" Value="#8B5CF6"/>
      <Setter Property="SelectionBrush" Value="#8B5CF6"/>
      <Setter Property="FontStretch" Value="Condensed"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="28"/>
      <Setter Property="Padding" Value="12,4"/>
      <Setter Property="Height" Value="52"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="#8B5CF6"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Chalk}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="track" Width="36" Height="20" CornerRadius="10" Background="#2B2F37">
                <Ellipse x:Name="knob" Width="14" Height="14" Fill="#ECE7DC" HorizontalAlignment="Left" Margin="3,0,0,0"/>
              </Border>
              <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="track" Property="Background" Value="#8B5CF6"/>
                <Setter TargetName="knob" Property="Fill" Value="#FFFFFF"/>
                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="knob" Property="Margin" Value="0,0,3,0"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="track" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border x:Name="RootBorder" Margin="14" CornerRadius="12" Background="{StaticResource Asphalt}" BorderBrush="{StaticResource Rule}" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.6" Color="#000000"/>
    </Border.Effect>
    <Grid x:Name="RootGrid">
      <Grid.RowDefinitions>
        <RowDefinition Height="56"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="80"/>
      </Grid.RowDefinitions>

      <!-- Заголовок -->
      <Grid x:Name="TitleBar" Background="#01000000">
        <StackPanel Orientation="Horizontal" Margin="22,0,0,0" VerticalAlignment="Center">
          <Image x:Name="LogoImg" Width="28" Height="28"/>
          <TextBlock Text="TTC" FontSize="18" FontWeight="SemiBold" Margin="11,0,0,1" VerticalAlignment="Center"/>
          <TextBlock Text="забив капта на Majestic RP" Foreground="{StaticResource Fog}" FontSize="13" Margin="12,2,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
          <!-- Сервер: список с Majestic Wiki (онлайн, техработы); семья: читается с планшета при первом открытии -->
          <Button x:Name="ServerBtn" Style="{StaticResource Plain}" Margin="0,0,20,0" ToolTip="Сервер Majestic RP: нажмите, чтобы выбрать">
            <StackPanel Orientation="Horizontal">
              <Rectangle x:Name="ServerDot" Width="8" Height="8" RadiusX="1.5" RadiusY="1.5" Fill="#5A5E66" VerticalAlignment="Center"/>
              <TextBlock x:Name="ServerText" Text="Сервер" FontSize="13" Margin="8,0,0,0" Foreground="{StaticResource Chalk}"/>
              <TextBlock Text="▾" FontSize="11" Margin="6,1,0,0" Foreground="{StaticResource Fog}" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="FamilyBtn" Style="{StaticResource Plain}" Margin="0,0,20,0" ToolTip="Семья: читается с планшета при первом его открытии">
            <StackPanel Orientation="Horizontal">
              <Rectangle x:Name="FamilyDot" Width="8" Height="8" RadiusX="1.5" RadiusY="1.5" Fill="#5A5E66" VerticalAlignment="Center"/>
              <TextBlock x:Name="FamilyText" Text="Семья" FontSize="13" Margin="8,0,0,0" Foreground="{StaticResource Chalk}"/>
            </StackPanel>
          </Button>
          <Button x:Name="LicBtn" Style="{StaticResource Plain}" Margin="0,0,16,0" ToolTip="Ключ: нажмите, чтобы сменить">
            <StackPanel Orientation="Horizontal">
              <Rectangle x:Name="LicDot" Width="8" Height="8" RadiusX="1.5" RadiusY="1.5" Fill="#5A5E66" VerticalAlignment="Center"/>
              <TextBlock x:Name="LicText" Text="Ключ" FontSize="13" Margin="8,0,0,0"/>
            </StackPanel>
          </Button>
          <Button x:Name="BtnMin" Style="{StaticResource WinBtn}" Content="—"/>
          <Button x:Name="BtnClose" Style="{StaticResource WinClose}" Content="✕"/>
        </StackPanel>
        <Rectangle Height="1" Fill="{StaticResource Rule}" VerticalAlignment="Bottom"/>
      </Grid>

      <Grid Grid.Row="1" Margin="24,22,24,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="372"/>
          <ColumnDefinition Width="40"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ЛЕВО: цель и параметры -->
        <StackPanel x:Name="Inputs">
          <TextBlock Text="Квадрат, который забиваем" Style="{StaticResource Label}"/>
          <!-- Карта территорий TTC (MapView): цель залита фиолетовым, при вводе кода карта перескакивает на неё -->
          <Border Background="#101215" CornerRadius="6" BorderBrush="{StaticResource Rule}" BorderThickness="1" HorizontalAlignment="Left">
            <Grid x:Name="TargetGrid" Width="364" Height="240"/>
          </Border>

          <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="150"/>
              <ColumnDefinition Width="16"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SquareBox" Style="{StaticResource Field}" CharacterCasing="Upper" MaxLength="5"/>
            <TextBlock x:Name="SquareInfo" Grid.Column="2" Style="{StaticResource Hint}" VerticalAlignment="Center" Text=""/>
          </Grid>

          <TextBlock Text="Капт на (время в форме атаки)" Style="{StaticResource Label}" Margin="0,16,0,8"/>
          <StackPanel Orientation="Horizontal">
            <Border x:Name="CaptHBox" CornerRadius="8" Background="{StaticResource Slate}" BorderBrush="{StaticResource Rule}" BorderThickness="1" Width="118" Height="64">
              <Grid>
                <TextBlock x:Name="CaptHText" Style="{StaticResource Num}" FontSize="42" Text="20" VerticalAlignment="Center" Margin="16,0,0,2"/>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
                  <Button x:Name="CaptHUp" Style="{StaticResource Small}" Content="▲" Height="25" FontSize="10" Margin="0,0,0,3"/>
                  <Button x:Name="CaptHDown" Style="{StaticResource Small}" Content="▼" Height="25" FontSize="10"/>
                </StackPanel>
              </Grid>
            </Border>
            <TextBlock Text=":" Style="{StaticResource Num}" FontSize="40" Foreground="{StaticResource Fog}" Margin="8,0,8,6" VerticalAlignment="Center"/>
            <Border x:Name="CaptMBox" CornerRadius="8" Background="{StaticResource Slate}" BorderBrush="{StaticResource Rule}" BorderThickness="1" Width="118" Height="64">
              <Grid>
                <TextBlock x:Name="CaptMText" Style="{StaticResource Num}" FontSize="42" Text="00" VerticalAlignment="Center" Margin="16,0,0,2"/>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
                  <Button x:Name="CaptMUp" Style="{StaticResource Small}" Content="▲" Height="25" FontSize="10" Margin="0,0,0,3"/>
                  <Button x:Name="CaptMDown" Style="{StaticResource Small}" Content="▼" Height="25" FontSize="10"/>
                </StackPanel>
              </Grid>
            </Border>
            <TextBlock Text="шаг 5 минут" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="14,0,0,0"/>
          </StackPanel>

          <TextBlock Text="Нажать «Запланировать атаку» в (МСК)" Style="{StaticResource Label}" Margin="0,16,0,8"/>
          <StackPanel Orientation="Horizontal">
            <TextBox x:Name="FireBox" Style="{StaticResource Field}" MaxLength="12" Width="176"/>
            <WrapPanel Margin="12,0,0,0" Width="184" VerticalAlignment="Center">
              <Button x:Name="ChipP10" Style="{StaticResource Quick}" Content="+10 с"/>
              <Button x:Name="ChipP1m" Style="{StaticResource Quick}" Content="+1 мин"/>
              <Button x:Name="ChipRound" Style="{StaticResource Quick}" Content="ровно :00"/>
              <Button x:Name="ChipSoon" Style="{StaticResource Quick}" Content="через 40 с" ToolTip="Для проверки: забив через 40 секунд"/>
            </WrapPanel>
          </StackPanel>
          <TextBlock x:Name="FireInfo" Style="{StaticResource Hint}" Margin="0,8,0,0" Text=""/>

          <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Людей, сверху списка" Style="{StaticResource Label}"/>
              <StackPanel Orientation="Horizontal">
                <Button x:Name="PeopleMinus" Style="{StaticResource Small}" Content="−"/>
                <TextBlock x:Name="PeopleText" Style="{StaticResource Num}" FontSize="30" Text="10" Width="54" TextAlignment="Center" VerticalAlignment="Center"/>
                <Button x:Name="PeoplePlus" Style="{StaticResource Small}" Content="+"/>
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Text="Начать заранее, сек" Style="{StaticResource Label}"/>
              <StackPanel Orientation="Horizontal">
                <Button x:Name="PrepMinus" Style="{StaticResource Small}" Content="−"/>
                <TextBlock x:Name="PrepText" Style="{StaticResource Num}" FontSize="30" Text="25" Width="54" TextAlignment="Center" VerticalAlignment="Center"/>
                <Button x:Name="PrepPlus" Style="{StaticResource Small}" Content="+"/>
              </StackPanel>
            </StackPanel>
          </Grid>
        </StackPanel>

        <!-- ПРАВО: отсчёт, пинг, ход забива -->
        <Grid Grid.Column="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <Grid>
            <TextBlock x:Name="HeroCap" Style="{StaticResource Label}" Text="До забива" Margin="0" VerticalAlignment="Center"/>
            <StackPanel x:Name="StatusChip" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <Rectangle x:Name="StatusDot" Width="8" Height="8" RadiusX="1.5" RadiusY="1.5" Fill="#8E929B" VerticalAlignment="Center"/>
              <TextBlock x:Name="StatusText" Text="Ожидание" FontSize="13" Margin="8,0,0,0"/>
            </StackPanel>
          </Grid>
          <TextBlock x:Name="Countdown" Grid.Row="1" Style="{StaticResource Num}" FontSize="104" Text="00:00:00.0" Margin="-5,-4,0,-10"/>
          <StackPanel Grid.Row="2" Margin="0,6,0,0">
            <TextBlock x:Name="NowText" Foreground="{StaticResource Fog}" FontSize="14" Text="Сейчас 00:00:00.000 по МСК"/>
            <Grid Margin="0,14,0,0" Height="3">
              <Border Background="{StaticResource Rule}"/>
              <Border x:Name="ProgFill" Background="{StaticResource Signal}" HorizontalAlignment="Left" Width="0"/>
            </Grid>
          </StackPanel>

          <!-- Пинг -->
          <Grid Grid.Row="3" Margin="0,26,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="138"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Пинг до сервера" Style="{StaticResource Label}"/>
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="PingValue" Style="{StaticResource Num}" FontSize="40" Text="—"/>
                <TextBlock Text="мс" Foreground="{StaticResource Fog}" FontSize="14" VerticalAlignment="Bottom" Margin="6,0,0,9"/>
              </StackPanel>
              <TextBlock x:Name="PingSub" Style="{StaticResource Hint}" FontSize="12" Text="читаю панель RTT в игре"/>
            </StackPanel>
            <Border Grid.Column="1" Margin="4,26,22,6" BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1" ClipToBounds="True">
              <Grid>
                <Canvas x:Name="SparkCanvas">
                  <Polyline x:Name="SparkLine" StrokeThickness="1.8" Stroke="{StaticResource Signal}" StrokeLineJoin="Round"/>
                </Canvas>
                <TextBlock x:Name="SparkHint" Text="график пинга появится, когда игра его покажет" Style="{StaticResource Hint}" FontSize="12" VerticalAlignment="Center" TextAlignment="Center"/>
              </Grid>
            </Border>
            <StackPanel Grid.Column="2">
              <TextBlock x:Name="LeadCap" Text="Нажму раньше на" Style="{StaticResource Label}"/>
              <TextBlock x:Name="LeadValue" Style="{StaticResource Num}" FontSize="30" Text="—"/>
              <TextBlock x:Name="LeadSub" Style="{StaticResource Hint}" FontSize="12" Text="половина пинга и полкадра" Margin="0,2,0,10"/>
              <CheckBox x:Name="AutoPing" Style="{StaticResource Switch}" Content="Учитывать пинг" IsChecked="True" Margin="0,0,0,10"/>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Поправка" Foreground="{StaticResource Fog}" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button x:Name="FineMinus" Style="{StaticResource Small}" Content="−" Width="28" Height="26"/>
                <TextBlock x:Name="FineText" Style="{StaticResource Num}" FontSize="16" Text="0 мс" Width="64" TextAlignment="Center" VerticalAlignment="Center"/>
                <Button x:Name="FinePlus" Style="{StaticResource Small}" Content="+" Width="28" Height="26"/>
              </StackPanel>
            </StackPanel>
          </Grid>

          <!-- Ход забива -->
          <Grid Grid.Row="4" Margin="0,24,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Rectangle Height="1" Fill="{StaticResource Rule}" VerticalAlignment="Top"/>
            <Grid Margin="0,14,0,10">
              <TextBlock Text="Ход забива" Style="{StaticResource Label}" Margin="0"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="TabSteps" Style="{StaticResource Plain}" Content="Шаги" FontSize="13" Margin="0,0,14,0"/>
                <Button x:Name="TabLog" Style="{StaticResource Plain}" Content="Журнал" FontSize="13"/>
              </StackPanel>
            </Grid>
            <StackPanel x:Name="StepsPanel" Grid.Row="1"/>
            <TextBox x:Name="LogBox" Grid.Row="1" Visibility="Collapsed" IsReadOnly="True" Background="{StaticResource Slate}" Foreground="#B9BCC3"
                     BorderThickness="0" FontFamily="Consolas" FontSize="11.5" Padding="10" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
          </Grid>
        </Grid>
      </Grid>

      <!-- Низ: готовность и действия -->
      <Grid Grid.Row="2">
        <Rectangle Height="1" Fill="{StaticResource Rule}" VerticalAlignment="Top"/>
        <Grid Margin="24,0,24,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <WrapPanel VerticalAlignment="Center">
            <Button x:Name="GameBtn" Style="{StaticResource Plain}" Margin="0,4,22,4" ToolTip="Окно игры и калибровка под его размер">
              <StackPanel Orientation="Horizontal">
                <Rectangle x:Name="RdGameDot" Width="8" Height="8" RadiusX="1.5" RadiusY="1.5" Fill="#5A5E66" VerticalAlignment="Center"/>
                <TextBlock x:Name="RdGame" Text="Ищу игру" FontSize="13" Margin="8,0,0,0" Foreground="{StaticResource Chalk}"/>
              </StackPanel>
            </Button>
            <StackPanel Orientation="Horizontal" Margin="0,4,22,4">
              <Rectangle x:Name="RdPingDot" Width="8" Height="8" RadiusX="1.5" RadiusY="1.5" Fill="#5A5E66" VerticalAlignment="Center"/>
              <TextBlock x:Name="RdPing" Text="Пинг" FontSize="13" Margin="8,0,0,0"/>
            </StackPanel>
            <Button x:Name="ClockBtn" Style="{StaticResource Plain}" Margin="0,4,22,4" ToolTip="Сверить часы ещё раз">
              <StackPanel Orientation="Horizontal">
                <Rectangle x:Name="RdClockDot" Width="8" Height="8" RadiusX="1.5" RadiusY="1.5" Fill="#5A5E66" VerticalAlignment="Center"/>
                <TextBlock x:Name="RdClock" Text="Сверяю часы" FontSize="13" Margin="8,0,0,0" Foreground="{StaticResource Chalk}"/>
              </StackPanel>
            </Button>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
              <Rectangle x:Name="RdTabDot" Width="8" Height="8" RadiusX="1.5" RadiusY="1.5" Fill="#5A5E66" VerticalAlignment="Center"/>
              <TextBlock x:Name="RdTab" Text="Планшет" FontSize="13" Margin="8,0,0,0"/>
            </StackPanel>
          </WrapPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="BtnTest" Style="{StaticResource Btn}" Height="50" Width="168" Content="Тест без нажатия" ToolTip="Пройти всё до конца, но не нажимать «Запланировать атаку»"/>
            <Button x:Name="BtnStop" Style="{StaticResource StopBtn}" Height="50" Width="124" Margin="10,0,0,0" Content="Стоп (F10)" IsEnabled="False"/>
            <Button x:Name="BtnStart" Style="{StaticResource Primary}" Height="50" Width="214" Margin="10,0,0,0" Content="Запустить забив"/>
          </StackPanel>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
